{
    "name": "@wae/open-panel-gui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "OpenPanel desktop client GUI built with @vmz/ui for `open-panel client`",
    "scripts": {
        "design:init": "vmz init design --preset web-surface",
        "check": "vmz check .",
        "build": "vmz build . --profile static && node --experimental-strip-types ./scripts/stage.ts",
        "serve": "vmz serve . --profile static",
        "stage": "node --experimental-strip-types ./scripts/stage.ts"
    },
    "dependencies": {
        "@vmz/core": "0.3.13",
        "@vmz/ui": "0.3.13",
        "@vmz/ui-icons": "0.3.13"
    },
    "devDependencies": {
        "@vmz/vmz": "0.3.13"
    },
    "license": "Apache-2.0",
    "repository": "https://github.com/nyar-os/OpenPanel"
}
