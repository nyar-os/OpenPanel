<template>
    <div data-open-panel="gui-root" class="op-root" data-theme="dark">
        <aside class="op-sidebar" aria-label="Workspace">
            <a href="/" class="op-sidebar__brand">
                <span class="op-sidebar__mark" aria-hidden="true">
                    OP
                </span>
                <span class="op-sidebar__name">
                    OpenPanel
                </span>
            </a>
            <nav class="op-sidebar__nav" aria-label="Navigation">
                <a href="/" class="op-sidebar__nav-item" data-active="true" aria-current="page">
                    Servers
                </a>
            </nav>
            <div class="op-sidebar__footer">
                <p class="op-sidebar__hint">
                    {{ entryHint }}
                </p>
            </div>
        </aside>
        <main class="op-main">
            <div class="op-body">
                <header class="op-head">
                    <h1>
                        {{ title }}
                    </h1>
                    <p>
                        {{ lead }}
                    </p>
                </header>
                <Card :title="rosterTitle" :description="rosterMeta">
                    <Empty v-if="!serverRows.length && !busy" :title="emptyTitle" :description="emptyDesc" />
                    <div v-else class="op-list">
                        <div
                            v-for="row in serverRows"
                            :key="row.id"
                            class="op-row"
                            :data-active="row.active ? 'true' : 'false'"
                        >
                            <div class="op-row__info">
                                <strong>
                                    {{ row.label }}
                                </strong>
                                <span>
                                    {{ row.url }}
                                </span>
                            </div>
                            <Button
                                type="button"
                                size="small"
                                :variant="row.active ? 'secondary' : 'default'"
                                :disabled="row.active || busy"
                                @click="useServer(row.id)"
                            >
                                {{ row.active ? activeLabel : useLabel }}
                            </Button>
                        </div>
                    </div>
                    <Alert v-if="error" tone="danger" roleName="alert" :title="errorTitle" :description="error" />
                    <Alert v-else-if="status" tone="info" roleName="status" :title="statusTitle" :description="status" />
                </Card>
            </div>
        </main>
    </div>
</template>
<style>
html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}
#app,
.op-root {
    width: 100%;
    height: 100%;
}
.op-root {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    height: 100vh;
    overflow: hidden;
    color: var(--vmz-text-ink, #e7f2ec);
    background:
        radial-gradient(circle at 12% 18%, rgba(61, 155, 110, 0.22), transparent 42%),
        linear-gradient(160deg, #101a16, #0b1210 60%, #121c18);
}
.op-sidebar {
    display: flex;
    flex: 0 0 15rem;
    flex-direction: column;
    box-sizing: border-box;
    width: 15rem;
    min-width: 0;
    border-right: 1px solid var(--vmz-line-default, #2e4038);
    background: var(--vmz-surface-mist, #1a2621);
}
.op-sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 3rem;
    padding: 0 0.875rem;
    border-bottom: 1px solid var(--vmz-line-default, #2e4038);
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
}
.op-sidebar__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.4rem;
    background: rgba(61, 155, 110, 0.22);
    color: #54ad7f;
    font-size: 0.7rem;
    font-weight: 700;
}
.op-sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
}
.op-sidebar__nav-item {
    padding: 0.55rem 0.7rem;
    border-radius: 0.45rem;
    color: var(--vmz-text-steel, #9bb5a8);
    text-decoration: none;
}
.op-sidebar__nav-item[data-active='true'] {
    background: rgba(61, 155, 110, 0.16);
    color: var(--vmz-text-ink, #e7f2ec);
}
.op-sidebar__footer {
    margin-top: auto;
    padding: 0.875rem;
    border-top: 1px solid var(--vmz-line-default, #2e4038);
}
.op-sidebar__hint {
    margin: 0;
    color: var(--vmz-text-muted, #7a9488);
    font-size: 0.75rem;
    line-height: 1.45;
}
.op-main {
    flex: 1 1 auto;
    min-width: 0;
    overflow: auto;
}
.op-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: min(44rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 1rem 2rem;
}
.op-head h1 {
    margin: 0 0 0.35rem;
    font-size: 1.5rem;
}
.op-head p {
    margin: 0;
    color: var(--vmz-text-steel, #9bb5a8);
}
.op-list {
    display: grid;
    gap: 0.55rem;
}
.op-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--vmz-line-default, #2e4038);
    border-radius: 0.55rem;
    background: rgba(8, 14, 12, 0.35);
}
.op-row[data-active='true'] {
    border-color: rgba(61, 155, 110, 0.7);
    box-shadow: inset 0 0 0 1px rgba(61, 155, 110, 0.25);
}
.op-row__info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
}
.op-row__info strong {
    font-size: 0.98rem;
}
.op-row__info span {
    color: var(--vmz-text-steel, #9bb5a8);
    font-size: 0.85rem;
    word-break: break-all;
}
</style>
<script client>
export default class IndexPage {
    title = 'OpenPanel';
    lead = 'Desktop control plane for local ops (services, sites, processes, and logs).';
    entryHint = 'Entry: open-panel client';
    rosterTitle = 'Managed servers';
    rosterMeta = 'Loading roster…';
    emptyTitle = 'No servers yet';
    emptyDesc = 'Use `open-panel servers add` first.';
    useLabel = 'Use';
    activeLabel = 'Active';
    errorTitle = 'Roster failed';
    statusTitle = 'Status';

    busy = false;
    error = '';
    status = '';
    serverRows = [];
    pendingId = '';

    onMount() {
        this.installHostBridge();
        this.refresh();
    }

    installHostBridge() {
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (!bridge || !bridge.addEventListener) return;
        bridge.addEventListener('message', (event) => {
            let data = event.data;
            if (typeof data === 'string') {
                try {
                    data = JSON.parse(data);
                } catch {
                    return;
                }
            }
            if (!data || typeof data !== 'object') return;
            if (data.type === 'roster' || data.type === 'rosterResult') {
                this.busy = false;
                if (data.ok === false) {
                    this.error = String(data.error?.message || data.error || 'roster failed');
                    this.status = '';
                    return;
                }
                this.applySnapshot(data.data || data.snapshot || data);
                if (this.pendingId) {
                    this.status = `Active server: ${this.pendingId}`;
                    this.pendingId = '';
                } else {
                    this.status = 'Roster ready.';
                }
                this.error = '';
            }
        });
    }

    post(message) {
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (!bridge || !bridge.postMessage) {
            this.error = 'Native bridge unavailable. Use `open-panel servers use --id …`.';
            this.status = '';
            return false;
        }
        bridge.postMessage(JSON.stringify(message));
        return true;
    }

    refresh() {
        if (!this.post({ type: 'roster.list' })) {
            this.loadSnapshot();
        }
    }

    async loadSnapshot() {
        try {
            const response = await fetch('./roster.snapshot.json', { cache: 'no-store' });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            this.applySnapshot(await response.json());
            this.status = 'Loaded roster snapshot.';
            this.error = '';
        } catch (error) {
            this.rosterMeta = 'Roster unavailable';
            this.error = String(error?.message || error);
            this.status = '';
        }
    }

    useServer(id) {
        this.pendingId = id;
        this.busy = true;
        this.status = `Switching to ${id}…`;
        this.error = '';
        if (!this.post({ type: 'roster.use', id })) {
            this.busy = false;
        }
    }

    applySnapshot(snapshot) {
        const servers = Array.isArray(snapshot?.servers) ? snapshot.servers : [];
        const activeId = snapshot?.activeId || '';
        this.rosterMeta = snapshot?.path
            ? `Config: ${snapshot.path} · active: ${activeId || '(none)'}`
            : `Active: ${activeId || '(none)'}`;
        this.serverRows = servers.map((server) => {
            const id = String(server.id || '');
            const label = server.label ? `${server.label} (${id})` : id;
            const url =
                server.resolvedUrl ||
                server.url ||
                (server.host ? `http://${server.host}:${server.port || 17890}/` : '(no url)');
            return {
                id,
                label,
                url: String(url),
                active: id === activeId,
            };
        });
    }
}
</script>
